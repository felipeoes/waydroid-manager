[Unit]
Description=waydroid-multi daemon (multiple Waydroid instances)
After=network.target dbus.service

[Service]
Type=dbus
BusName=io.github.waydroidmulti.Manager
ExecStart=@BINDIR@/waydroid-multi-daemon
UMask=0022
# Containers (own cgroups) and the dnsmasq unit keep running across daemon
# restarts; the restarted daemon adopts them.
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
